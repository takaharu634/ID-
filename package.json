{
  "name": "tohto-baseball-savant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run build && npm run test:unit && node --test tests/rendered-html.test.mjs && npm run test:runtime",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "news:update": "node scripts/update-news.mjs",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "prepare:data": "node scripts/prepare-data.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.ts tests/catalog-refresh.test.mjs tests/autumn-import.test.mjs tests/import-pipeline.test.mjs tests/catcher-view.test.mjs tests/drive-push.test.mjs tests/longevity/*.test.mjs",
    "trackman:sync": "node scripts/sync-autumn-data.mjs",
    "test:batting": "node --test tests/batting-ui.test.mjs tests/autumn-import.test.mjs",
    "test:autumn": "node --test tests/autumn-import.test.mjs tests/batting-ui.test.mjs tests/autumn-spin.test.mjs",
    "test:import": "node --test tests/import-pipeline.test.mjs",
    "test:runtime": "node --test --test-concurrency=1 tests/import-runtime.test.mjs tests/drive-push-runtime.test.mjs tests/backup-runtime.test.mjs",
    "test:drive-push": "node --test tests/drive-push.test.mjs",
    "predev": "node scripts/prepare-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "ID東都"
}
